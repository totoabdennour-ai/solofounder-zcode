{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/totoabdennour-ai/solofounder-zcode/schemas/flow.schema.json",
  "title": "SoloFounder Workflow",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "goal", "complexity", "risk", "status", "revision", "planApproval", "stages"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1},
    "complexity": {"enum": ["quick", "standard", "complex"]}, "risk": {"enum": ["low", "moderate", "high", "critical"]},
    "status": {"enum": ["active", "ready_to_close", "completed", "blocked", "cancelled"]}, "revision": {"type": "integer", "minimum": 1},
    "planApproval": {"type": "object", "required": ["required", "status"], "properties": {"required":{"type":"boolean"},"status":{"enum":["pending","approved","not_required"]}}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "goal", "dependsOn", "status", "approvalRequired", "checks"], "properties": {
      "id":{"type":"string"}, "title":{"type":"string"}, "goal":{"type":"string"}, "dependsOn":{"type":"array","items":{"type":"string"}},
      "status":{"enum":["pending","in_progress","blocked","completed"]}, "approvalRequired":{"type":"boolean"}, "checks":{"type":"array","items":{"type":"object","required":["id","description","required","status"],"properties":{"id":{"type":"string"},"description":{"type":"string"},"required":{"type":"boolean"},"status":{"enum":["pending","passed","failed","not_applicable"]},"evidence":{"type":"array"}}}}
    }}}
  }
}
